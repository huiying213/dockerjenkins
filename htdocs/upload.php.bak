<?php
$targetDir = "uploads/";

// 检查文件夹是否存在，不存在则创建
if (!is_dir($targetDir)) {
    mkdir($targetDir, 0755, true);
}

$uploadOk = true;
$log = "";

// 检查是否有文件上传
if (!isset($_FILES["myfile"])) {
    $log .= "没有接收到文件数据。\n";
    $uploadOk = false;
} else {
    $file = $_FILES["myfile"];
    $targetFile = $targetDir . basename($file["name"]);

    // 检查是否有错误
    if ($file["error"] !== UPLOAD_ERR_OK) {
        $log .= "上传错误，错误代码：" . $file["error"] . "\n";
        $log .= upload_error_message($file["error"]);
        $uploadOk = false;
    }

    // 如果没有错误，尝试移动文件
    if ($uploadOk) {
        if (move_uploaded_file($file["tmp_name"], $targetFile)) {
            echo "✅ 上传成功： " . htmlspecialchars(basename($file["name"])) . "<br>";
        } else {
            $log .= "❌ move_uploaded_file 失败，文件未保存。\n";
            $uploadOk = false;
        }
    }
}

// 如果上传失败，打印日志
if (!$uploadOk) {
    echo "<pre>上传失败日志：\n" . $log . "</pre>";
}

// 错误码解释函数
function upload_error_message($code) {
    switch ($code) {
        case UPLOAD_ERR_INI_SIZE:    return "文件超过了 php.ini 中 upload_max_filesize 限制。";
        case UPLOAD_ERR_FORM_SIZE:   return "文件超过了 HTML 表单中 MAX_FILE_SIZE 限制。";
        case UPLOAD_ERR_PARTIAL:     return "文件只有部分被上传。";
        case UPLOAD_ERR_NO_FILE:     return "没有文件被上传。";
        case UPLOAD_ERR_NO_TMP_DIR:  return "找不到临时文件夹。";
        case UPLOAD_ERR_CANT_WRITE:  return "文件写入失败。";
        case UPLOAD_ERR_EXTENSION:   return "某个 PHP 扩展中止了上传。";
        default: return "未知错误。";
    }
}
?>